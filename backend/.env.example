# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (For local: mongodb://127.0.0.1:27017/chess_academy | For Vercel: MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/chess_academy

# Frontend Client URL for CORS (e.g. https://online-chess-academy-for-kids-97ai.vercel.app on Vercel)
FRONTEND_URL=http://localhost:3000

# Authentication & Security (Must be at least 32 characters in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_for_security
JWT_EXPIRES_IN=7d
COOKIE_NAME=chess_academy_token

