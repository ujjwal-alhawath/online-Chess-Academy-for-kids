{
  "name": "kids-chess-academy-backend",
  "version": "1.0.0",
  "description": "Backend API for Kids Chess & Strategic Thinking Academy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "db:verify": "tsx src/scripts/verifyDb.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "auth:verify": "tsx src/scripts/verifyAuth.ts",
    "p4:verify": "tsx src/scripts/verifyPhase4.ts",
    "p5:verify": "tsx src/scripts/verifyPhase5.ts",
    "p6:verify": "tsx src/scripts/verifyPhase6.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
