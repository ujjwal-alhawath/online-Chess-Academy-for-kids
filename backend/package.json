{
  "name": "kids-chess-academy-backend",
  "version": "1.0.0",
  "description": "Backend API for Kids Chess & Strategic Thinking Academy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
